# Clean stale flags (> 24 h)
file(GLOB _bc_old "${_BC_TD}/rbc_*.flag")
string(TIMESTAMP _bc_now "%s" UTC)
foreach(_f IN LISTS _bc_old)
  if(EXISTS "${_f}")
    file(TIMESTAMP "${_f}" _bc_ft "%s" UTC)
    if(_bc_ft)
      math(EXPR _bc_age "${_bc_now} - ${_bc_ft}")
      if(_bc_age GREATER 86400)
        file(REMOVE "${_f}")
      endif()
    endif()
  endif()
endforeach()

